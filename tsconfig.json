{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ks/viewers": ["./packages/viewers/src/index.ts"],
      "@ks/contracts": ["./packages/contracts/src/index.ts"],
      "@ks/api-client": ["./packages/api-client/src/index.ts"],
      "@ks/shell": ["./packages/shell/src/index.ts"],
      "@ks/shell/providers": ["./packages/shell/src/providers/index.ts"],
      "@ks/shell/react": ["./packages/shell/src/react/index.ts"],
      "@ks/shell/testing": ["./packages/shell/src/testing/index.ts"],
      "@ks/module-explorer": ["./packages/module-explorer/src/index.ts"],
      "@ks/ui": ["./packages/ui/src/index.ts"],
      "@ks/util": ["./packages/util/src/index.ts"],
      "@ks/i18n": ["./packages/i18n/src/index.ts"],
      "@ks/i18n/react": ["./packages/i18n/src/react/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "src/types/**/*.d.ts", ".next/types/**/*.ts", "scripts/find-nextjs-route-params-issues.js"],
  "exclude": ["node_modules", "docs", "public", "sampleapp"]
}